{
	"name": "@alchemy-unifi/network",
	"version": "0.0.1",
	"description": "Alchemy provider for the UniFi Network application.",
	"keywords": [
		"alchemy",
		"effect",
		"infrastructure-as-code",
		"ubiquiti",
		"unifi"
	],
	"homepage": "https://github.com/HamishWHC/alchemy-unifi/tree/main/packages/network#readme",
	"bugs": {
		"url": "https://github.com/HamishWHC/alchemy-unifi/issues"
	},
	"license": "MIT",
	"author": "HamishWHC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HamishWHC/alchemy-unifi.git",
		"directory": "packages/network"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@alchemy-unifi/source": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check"
	},
	"dependencies": {
		"@alchemy-unifi/network-sdk": "workspace:*"
	},
	"devDependencies": {
		"@alchemy-unifi/test-controller": "workspace:*",
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@total-typescript/ts-reset": "catalog:",
		"@types/node": "catalog:",
		"alchemy": "catalog:",
		"effect": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/platform-node": "^4.0.6",
		"alchemy": "^2.0.0-beta.84",
		"effect": "^4.0.6"
	},
	"engines": {
		"node": ">=22"
	}
}
