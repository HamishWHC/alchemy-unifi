{
	"description": "The spec lists the basic data rates as string enum values (\"6000\") on integer fields, so the SDK typed them as strings; the console rejects strings (api.request.property-type-mismatch) and wants numbers.",
	"patches": [
		{
			"op": "replace",
			"path": "/shapes/com.ui.network#IntegrationWifiBasicDataRateConfigurationDto/members/_2_4/target",
			"value": "smithy.api#Integer"
		},
		{
			"op": "add",
			"path": "/shapes/com.ui.network#IntegrationWifiBasicDataRateConfigurationDto/members/_2_4/traits/smithy.api#documentation",
			"value": "Basic data rate for 2.4 GHz in kbps: 1000, 2000, 5500, 6000, 9000, 11000, 12000 or 24000."
		},
		{
			"op": "replace",
			"path": "/shapes/com.ui.network#IntegrationWifiBasicDataRateConfigurationDto/members/_5/target",
			"value": "smithy.api#Integer"
		},
		{
			"op": "add",
			"path": "/shapes/com.ui.network#IntegrationWifiBasicDataRateConfigurationDto/members/_5/traits/smithy.api#documentation",
			"value": "Basic data rate for 5 GHz in kbps: 6000, 9000, 12000 or 24000."
		}
	]
}
