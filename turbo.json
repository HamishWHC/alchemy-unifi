{
	"$schema": "./node_modules/turbo/schema.json",
	"tasks": {
		"generate": {
			"inputs": ["openapi/**", "scripts/**"],
			"outputs": ["src/services/**"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^test"],
			"cache": false
		},
		"test:unit": {},
		"test:controller": {
			"dependsOn": ["^test:controller"],
			"cache": false
		},
		"lint": {},
		"lint:fix": {},
		"fmt": {},
		"fmt:check": {},
		"check": {
			"dependsOn": ["typecheck", "lint", "fmt:check"]
		}
	}
}
