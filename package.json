{
	"name": "alchemy-unifi",
	"version": "0.0.0",
	"private": true,
	"description": "Alchemy providers for Ubiquiti UniFi.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run check",
		"typecheck": "turbo run typecheck",
		"test": "vitest run",
		"test:unit": "vitest run --project '*(unit)'",
		"test:controller": "vitest run --project '*(controller)'",
		"generate": "turbo run generate",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"release": "turbo run build && pnpm publish -r",
		"cloc": "cloc --vcs=git --fullpath --not-match-d='/packages/network-sdk/(openapi|src/services)(/|$)' --not-match-f='/pnpm-lock\\.yaml$'",
		"prepare": "lefthook install && effect-tsgo patch"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"lefthook": "^2.2.2",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"turbo": "^2.11.10",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.15.0",
			"onFail": "download"
		}
	}
}
